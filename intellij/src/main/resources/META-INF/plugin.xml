<idea-plugin>
  <id>com.gamjak.codexcost</id>
  <name>Codex Cost</name>
  <vendor email="gambkej@gmx.net" url="https://github.com/gamjak/codex_cost_extension">gamjak</vendor>
  <depends>com.intellij.modules.platform</depends>

  <description><![CDATA[
    <p>Local Codex usage and cost estimates.</p>
  ]]></description>

  <extensions defaultExtensionNs="com.intellij">
    <statusBarWidgetFactory id="CodexCost.Session" implementation="com.gamjak.codexcost.statusbar.SessionCostWidgetFactory"/>
    <statusBarWidgetFactory id="CodexCost.Project" implementation="com.gamjak.codexcost.statusbar.ProjectCostWidgetFactory"/>
    <statusBarWidgetFactory id="CodexCost.Budget" implementation="com.gamjak.codexcost.statusbar.BudgetCostWidgetFactory"/>
  </extensions>
</idea-plugin>
